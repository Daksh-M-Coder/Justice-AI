{
  "name": "justiceai",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "selftest": "node scripts/probe_health.mjs",
    "accept": "node scripts/accept.mjs",
    "live:check": "node scripts/live_check.mjs",
    "verify:sources": "node scripts/verify_sources.mjs",
    "verify:laws": "node scripts/verify_sources.mjs --kind=laws",
    "verify:precedents": "node scripts/verify_sources.mjs --kind=precedents",
    "verify:links": "node scripts/verify_sources.mjs --kind=links",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "jspdf": "^4.2.1",
    "minisearch": "^7.2.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
